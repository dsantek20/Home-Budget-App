{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI (Uvicorn)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/app",
            "args": [
                "app:app",
                "--reload"
            ],
            "envFile": "${workspaceFolder}/app/.env",
            "jinja": true
        },
    ]
}